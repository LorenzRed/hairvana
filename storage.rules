rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function activeSellerOrStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/profiles/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.role in ['seller', 'staff'];
    }

    match /product-images/{userId}/{imageId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && activeSellerOrStaff()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
